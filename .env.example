# PHYSICS LAB AI — backend configuration
#
# Copy to `.env` at the repository root (or backend/.env) and edit.  Every variable
# is optional: the defaults below are exactly what the app falls back to, so a bare
# `uvicorn app.main:app` runs with zero configuration in development.
#
# All names carry the PLAB_ prefix (pydantic-settings env_prefix).  Lists use JSON.

# --- general ---------------------------------------------------------------------
# development | test | staging | production
# In `production` a missing PLAB_SECRET_KEY is a hard startup error, demo seeding is
# disabled, and the demo account is not created.
PLAB_ENVIRONMENT=development
PLAB_APP_NAME=PHYSICS LAB AI
PLAB_API_V1_PREFIX=/api/v1
PLAB_LOG_LEVEL=INFO
PLAB_LOG_JSON=true
# Let unexpected exceptions reach the ASGI caller instead of becoming a 500 envelope.
# Tests only.  Never enable in production: it leaks internals to whoever calls you.
PLAB_DEBUG_PROPAGATE_ERRORS=false

# --- persistence -----------------------------------------------------------------
# Defaults to SQLite under backend/data so the project runs with no infrastructure.
# Any SQLAlchemy URL works unchanged, e.g.
#   postgresql+psycopg://lab:lab@localhost:5432/physics_lab
# PLAB_DATABASE_URL=sqlite:///./data/physics_lab.db
PLAB_DB_POOL_SIZE=10
# PLAB_DATA_DIR=./backend/data
# PLAB_UPLOADS_DIR=./backend/data/uploads
# PLAB_ARTIFACTS_DIR=./backend/data/artifacts

# --- auth ------------------------------------------------------------------------
# Signs session tokens.  Required in production.  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PLAB_SECRET_KEY=
PLAB_SESSION_COOKIE_NAME=plab_session
PLAB_CSRF_COOKIE_NAME=plab_csrf
PLAB_CSRF_HEADER_NAME=X-CSRF-Token
# 12 hours.  Sessions are also revoked wholesale by bumping the user's token_version
# (which POST /auth/password does automatically).
PLAB_SESSION_TTL_SECONDS=43200
# Set true when served over HTTPS; the app also needs PLAB_COOKIE_SECURE for the
# Secure flag to appear on cookies.
PLAB_COOKIE_SECURE=false
# argon2id cost parameters (time cost = passes over memory, memory in KiB).
# Lower these only for tests; they are the reason a login attempt is expensive.
PLAB_ARGON2_TIME_COST=3
PLAB_ARGON2_MEMORY_KIB=65536
PLAB_ARGON2_PARALLELISM=2
# Demo account created on first boot in development/test (see backend/app/scripts/seed_demo.py).
PLAB_DEMO_ACCOUNT_ENABLED=true
PLAB_DEMO_EMAIL=demo@physicslab.local
# Change this if the instance is reachable by anyone else.
PLAB_DEMO_PASSWORD=demo-password-123

# --- compute limits (enforced per request AND per account) -----------------------
PLAB_MAX_BODY_BYTES=2000000
PLAB_MAX_UPLOAD_BYTES=10000000
PLAB_MAX_EXPRESSION_CHARS=400
PLAB_MAX_ITERATIONS=200
PLAB_DEFAULT_TOLERANCE=1e-10
# Wall-clock bound per job; exceeding it fails the run with execution_timeout.
PLAB_COMPUTE_TIMEOUT_SECONDS=20
PLAB_MAX_GRID_POINTS=20000
PLAB_MAX_OUTPUT_POINTS=200000
PLAB_MAX_AGENT_STEPS=8
PLAB_MAX_AGENT_TOOL_CALLS=12
PLAB_MAX_PROVIDER_RETRIES=1
PLAB_PAGE_SIZE=20
PLAB_MAX_PAGE_SIZE=100

# --- rate limiting -----------------------------------------------------------------
# In-process and per-worker: it resets on restart.  Use a shared store in production
# (this limitation is also reported by GET /api/v1/capabilities -> security.gaps).
PLAB_RATE_LIMIT_ENABLED=true
PLAB_RATE_LIMIT_DEFAULT=240/minute
PLAB_RATE_LIMIT_AUTH=10/minute
PLAB_RATE_LIMIT_COMPUTE=40/minute

# --- AI provider (server-side only; never exposed to the browser) -----------------
# mock        -> deterministic rule-based planner (default; no network, no key).
#                Every answer is labelled as a rule planner, never as a language model.
# anthropic   -> requires PLAB_ANTHROPIC_API_KEY
# openai      -> requires PLAB_OPENAI_API_KEY
PLAB_AI_PROVIDER=mock
PLAB_ANTHROPIC_API_KEY=
PLAB_ANTHROPIC_MODEL=claude-sonnet-4-5
PLAB_ANTHROPIC_BASE_URL=https://api.anthropic.com
PLAB_OPENAI_API_KEY=
PLAB_OPENAI_MODEL=gpt-4o-mini
PLAB_OPENAI_BASE_URL=https://api.openai.com/v1
PLAB_AI_TIMEOUT_SECONDS=60
PLAB_AI_MAX_TOKENS=2048
# Literature search.  When PLAB_RESEARCH_SEARCH_BASE_URL is empty, the
# search_scientific_sources tool reports status="not_performed" and returns only the
# locally curated references, labelled local_curated_reference.  It never invents
# citations.
PLAB_RESEARCH_SEARCH_BASE_URL=
PLAB_RESEARCH_SEARCH_API_KEY=
PLAB_RESEARCH_TIMEOUT_SECONDS=15

# --- CORS --------------------------------------------------------------------------
# JSON list of exact origins (no trailing slash) allowed to call the API with credentials.
PLAB_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- frontend (Next.js dev/prod server) ----------------------------------------------
# Read by frontend/next.config.mjs. The browser never sees a backend host: /api/v1/* is
# proxied server-side to this origin, which keeps the session cookie first-party (that is
# what makes the double-submit CSRF cookie work).
PLAB_BACKEND_ORIGIN=http://127.0.0.1:8000
# Comma-separated extra hostnames allowed to load the dev server (the sandbox/tunnel host).
# Leave empty for plain localhost development.
PLAB_ALLOWED_DEV_ORIGINS=
